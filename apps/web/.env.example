# Vercel Deployment & Environment Variables for ELOCIA Web

# Portal Selector: 'teacher', 'parent', 'admin', or 'all' (default: all)
# When deploying to Vercel, set this variable in each project's settings:
# - Project 1 (elocia-teacher): VITE_PORTAL=teacher
# - Project 2 (elocia-parent):  VITE_PORTAL=parent
# - Project 3 (elocia-admin):   VITE_PORTAL=admin
VITE_PORTAL=all

# Live Backend FastAPI URL
# Example: https://elocia-backend.up.railway.app
# If omitted, defaults to http://localhost:8000 for local development.
VITE_API_URL=http://localhost:8000
